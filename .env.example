# Optional household LAN access protection.
# Leave empty to disable. Set a numeric or text PIN to require browser login.
MEDIA_DICTATION_PIN=
# Optional persistent Flask session signing key. If blank, a new random key is
# generated on each server start and browsers will need to log in again.
MEDIA_DICTATION_SECRET_KEY=

# LLM provider for sentence translation and word lookup:
#   auto   = Ollama first, OpenAI fallback
#   ollama = local Ollama only
#   openai = OpenAI only
LLM_PROVIDER=auto

# Local Ollama configuration.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:UD-Q4_K_XL
OLLAMA_TRANSLATION_TIMEOUT_SECONDS=60
# In auto mode, fail over quickly enough that OpenAI still has time to answer.
OLLAMA_AUTO_TRANSLATION_TIMEOUT_SECONDS=12

OLLAMA_WORD_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:UD-Q4_K_XL
OLLAMA_WORD_TIMEOUT_SECONDS=45
OLLAMA_AUTO_WORD_TIMEOUT_SECONDS=7

# Learning-center 30-day narrative summary.
OLLAMA_REPORT_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:UD-Q4_K_XL
OLLAMA_REPORT_TIMEOUT_SECONDS=60
OLLAMA_AUTO_REPORT_TIMEOUT_SECONDS=20

# Optional OpenAI fallback / cloud-only configuration.
OPENAI_API_KEY=your_openai_api_key_here

# Full-sentence Chinese translation: Luna via Flex.
OPENAI_TRANSLATION_MODEL=gpt-5.6-luna
OPENAI_TRANSLATION_SERVICE_TIER=flex
OPENAI_TRANSLATION_TIMEOUT_SECONDS=45

# Clickable word lookup: Luna on the normal real-time/default service tier.
OPENAI_WORD_MODEL=gpt-5.6-luna
OPENAI_WORD_SERVICE_TIER=default
OPENAI_WORD_TIMEOUT_SECONDS=15

OPENAI_REPORT_MODEL=gpt-5.6-luna
OPENAI_REPORT_SERVICE_TIER=flex
OPENAI_REPORT_TIMEOUT_SECONDS=45

# Optional local media transcription.
# Install with setup_whisper_windows.bat.
WHISPER_MODEL=small.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
# Recommended for an 8 GB GPU: free Qwen VRAM before loading Whisper.
WHISPER_RELEASE_OLLAMA=true
WHISPER_COMPUTE_TYPE_CUDA=int8_float16
WHISPER_COMPUTE_TYPE_CPU=int8
# Put large Whisper model downloads on a non-system drive if desired.
WHISPER_DOWNLOAD_ROOT=E:/AI/whisper-models
# Uploaded local media can also live outside the repository.
MEDIA_DICTATION_MEDIA_DIR=E:/AI/media-dictation-media
MEDIA_MAX_UPLOAD_MB=1024
